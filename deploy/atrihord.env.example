# Environment of the atrihord service. Copy to atrihord.env next to server.py and edit.

# Where the server listens. 127.0.0.1 = only this machine (use that behind a reverse proxy on the same machine).
MEDIA_BIND=127.0.0.1
MEDIA_PORT=8000

# --- Sign-in, choose ONE of the two ---------------------------------------------------------------
# (a) Reverse proxy with forward auth (Caddy + Authelia, see deploy/Caddyfile.example). The server believes
#     the Remote-User / Remote-Groups headers, but only from these addresses:
MEDIA_PROXY_IPS=127.0.0.1,::1
MEDIA_ADMIN_GROUPS=admins
MEDIA_GUEST_GROUPS=media
MEDIA_AUTH_URL=https://auth.example.org
MEDIA_PUBLIC_URL=https://media.example.org
# (b) Private machine, no login at all: every request is this admin. NEVER on a reachable server.
#MEDIA_SINGLE_USER=me

# --- Optional -------------------------------------------------------------------------------------
# Vision worker (GPU machine). Can also be set in the settings page.
#MEDIA_VISION_WORKER=http://127.0.0.1:8410
# Where the music page's "Spatial app" link goes when this server does not host the zip itself (https only)
#MEDIA_BRIDGE_DOWNLOAD_URL=https://github.com/OWNER/ksf-spatial-bridge/releases/latest
# Where data lives (all optional; unset = next to the app). Library = the stored media; cache = big derived
# media that can be rebuilt (3D, upscaled copies, ugoira videos, audio remuxes, video-trim data); preview =
# thumbnails and face crops (many small files, a fast disk helps).
#MEDIA_LIBRARY_DIR=/srv/media/library
#MEDIA_CACHE_DIR=/srv/media/cache
#MEDIA_PREVIEW_DIR=/srv/fast/previews
# Folder for the 2D->3D conversion cache (overrides MEDIA_CACHE_DIR/3d) (must exist). Default ~/.cache/atrihord-3d
#MEDIA_3D_CACHE=/var/cache/atrihord-3d
